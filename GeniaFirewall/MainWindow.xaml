<Window x:Class="GeniaFirewall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Main.WindowTitle}"
        Icon="Assets/geniafirewall.ico"
        Width="900" Height="590"
        MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Compact toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/geniafirewall.png" Width="22" Height="22" Stretch="Uniform" />
                    <TextBlock Text="GeniaFirewall" FontSize="14" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                    <Border Background="#EEEAFE" CornerRadius="5" Padding="5,2" Margin="6,0,0,0">
                        <TextBlock Text="0.7.3" Foreground="{StaticResource AccentBrush}" FontSize="9.5" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{DynamicResource Main.ModeLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />

                <ComboBox x:Name="ModeComboBox" Grid.Column="4" Height="30" FontSize="11.5" VerticalContentAlignment="Center" SelectionChanged="ModeComboBox_SelectionChanged">
                    <ComboBoxItem Tag="Normal" Content="{DynamicResource Mode.Normal}" />
                    <ComboBoxItem Tag="BlockAll" Content="{DynamicResource Mode.BlockAll}" />
                    <ComboBoxItem Tag="AllowAll" Content="{DynamicResource Mode.AllowAll}" />
                    <ComboBoxItem Tag="Monitor" Content="{DynamicResource Mode.Monitor}" />
                </ComboBox>

                <Grid Grid.Column="6">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource CompactTextBox}"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="{DynamicResource Main.SearchTooltip}" />
                    <TextBlock x:Name="SearchWatermark"
                               Text="{DynamicResource Main.SearchWatermark}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#A19EAD"
                               FontSize="12"
                               IsHitTestVisible="False" />
                </Grid>

                <Button Grid.Column="8" Content="{DynamicResource Main.Clear}" Style="{StaticResource SystemButton}" Click="ClearList_Click" />
                <Button Grid.Column="10" Content="{DynamicResource Main.Add}" Style="{StaticResource SystemAccentButton}" Click="AddApplication_Click" />
                <Button Grid.Column="12" Width="34" Content="⚙" Style="{StaticResource SystemButton}" ToolTip="{DynamicResource Main.Settings}" Click="SettingsButton_Click" />

                <Button x:Name="ProtectionButton" Grid.Column="14" Width="112" Style="{StaticResource SystemAccentButton}" Click="ProtectionButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="ProtectionDot" Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ProtectionText" Text="{DynamicResource Main.ProtectionOn}" Foreground="#5146A6" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Programs table: stable vertical scrollbar, no horizontal scrollbar -->
        <Border Grid.Row="1" Margin="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
            <Grid>
                <ListView x:Name="ApplicationsList"
                          ItemsSource="{Binding Applications}"
                          BorderThickness="0"
                          Background="Transparent"
                          SelectionMode="Single"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          PreviewMouseRightButtonDown="ApplicationsList_PreviewMouseRightButtonDown"
                          MouseDoubleClick="ApplicationsList_MouseDoubleClick"
                          SizeChanged="ApplicationsList_SizeChanged">
                    <ListView.Resources>
                        <Style x:Key="LeftColumnHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="{DynamicResource Main.SortTooltip}" />
                        </Style>
                        <Style x:Key="CenterColumnHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="{DynamicResource Main.SortTooltip}" />
                        </Style>
                    </ListView.Resources>
                    <ListView.ContextMenu>
                        <ContextMenu Opened="ApplicationsContextMenu_Opened">
                            <MenuItem x:Name="ContextAllowItem" Header="{DynamicResource Main.Context.Allow}" Click="ContextAllow_Click" />
                            <MenuItem x:Name="ContextBlockItem" Header="{DynamicResource Main.Context.Block}" Click="ContextBlock_Click" />
                            <MenuItem x:Name="ContextAskItem" Header="{DynamicResource Main.Context.Ask}" Click="ContextAsk_Click" />
                            <MenuItem x:Name="ContextQuickRulesItem" Header="{DynamicResource Main.Context.QuickRules}">
                                <MenuItem x:Name="ContextQuickEnableAllItem" Header="{DynamicResource Main.Context.EnableAll}" ToolTip="{DynamicResource Main.Context.EnableAllHint}" IsCheckable="True" Click="ContextQuickEnableAll_Click" />
                                <MenuItem x:Name="ContextQuickOutgoingOnlyItem" Header="{DynamicResource Main.Context.OutgoingOnly}" ToolTip="{DynamicResource Main.Context.OutgoingOnlyHint}" IsCheckable="True" Click="ContextQuickOutgoingOnly_Click" />
                                <MenuItem x:Name="ContextQuickIncomingOnlyItem" Header="{DynamicResource Main.Context.IncomingOnly}" ToolTip="{DynamicResource Main.Context.IncomingOnlyHint}" IsCheckable="True" Click="ContextQuickIncomingOnly_Click" />
                                <Separator />
                                <MenuItem x:Name="ContextQuickDisableAllItem" Header="{DynamicResource Main.Context.DisableAll}" IsCheckable="True" Click="ContextQuickDisableAll_Click" />
                                <MenuItem x:Name="ContextQuickAskItem" Header="{DynamicResource Main.Context.QuickAsk}" IsCheckable="True" Click="ContextQuickAsk_Click" />
                            </MenuItem>
                            <MenuItem x:Name="ContextTemporaryAccessItem" Header="{DynamicResource Main.Context.Temporary}">
                                <MenuItem Header="{DynamicResource Main.Context.TempTenMinutes}" Click="ContextTempTenMinutes_Click" />
                                <MenuItem Header="{DynamicResource Main.Context.TempUntilExit}" Click="ContextTempUntilExit_Click" />
                            </MenuItem>
                            <MenuItem x:Name="ContextShowPromptItem" Header="{DynamicResource Main.Context.ShowPrompt}" Click="ContextShowPrompt_Click" />
                            <MenuItem x:Name="ContextMutePromptItem" Header="{DynamicResource Main.Context.MutePrompt}" IsCheckable="True" Click="ContextMutePrompt_Click" />
                            <Separator />
                            <MenuItem x:Name="ContextPropertiesItem" Header="{DynamicResource Main.Context.Properties}" Click="ContextProperties_Click" />
                            <MenuItem x:Name="ContextOpenLocationItem" Header="{DynamicResource Main.Context.OpenLocation}" Click="ContextOpenLocation_Click" />
                            <MenuItem x:Name="ContextResetStatisticsItem" Header="{DynamicResource Main.Context.ResetStats}" Click="ContextResetStatistics_Click" />
                            <Separator />
                            <MenuItem x:Name="ContextRemoveItem" Header="{DynamicResource Main.Context.Remove}" InputGestureText="Del" Click="ContextRemove_Click" />
                            <MenuItem Header="{DynamicResource Main.Context.RemoveMissing}" Click="ContextRemoveMissing_Click" />
                            <Separator />
                            <MenuItem Header="{DynamicResource Main.Context.Refresh}" InputGestureText="F5" Click="ContextRefresh_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>

                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn x:Name="ProgramColumn" Width="315">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader x:Name="ProgramHeader" Tag="Name" Content="{DynamicResource Column.Program}" Style="{StaticResource LeftColumnHeaderStyle}" Click="ColumnHeader_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding ProgramToolTip}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="19" Height="19" CornerRadius="4" Background="#EEEAFE" VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding IconSource}" Width="17" Height="17" Stretch="Uniform" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProgramSubtitle}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ParentProcessName}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="StatusColumn" Width="112">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader x:Name="StatusHeader" Tag="AccessLabel" Content="{DynamicResource Column.Status}" Style="{StaticResource CenterColumnHeaderStyle}" Click="ColumnHeader_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AccessLabel}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AskBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Access}" Value="Allow">
                                                            <Setter Property="Foreground" Value="{StaticResource AllowedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Access}" Value="Block">
                                                            <Setter Property="Foreground" Value="{StaticResource BlockedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FingerprintChanged}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AskBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="TrustColumn" Width="96">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader x:Name="TrustHeader" Tag="TrustLabel" Content="{DynamicResource Column.Trust}" Style="{StaticResource CenterColumnHeaderStyle}" Click="ColumnHeader_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TrustLabel}"
                                                   ToolTip="{Binding TrustReason}"
                                                   FontSize="10.5"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTrustedSystem}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AllowedBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ProtocolColumn" Width="72">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader x:Name="ProtocolHeader" Tag="ProtocolLabel" Content="{DynamicResource Column.Protocol}" Style="{StaticResource CenterColumnHeaderStyle}" Click="ColumnHeader_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProtocolLabel}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ActivityColumn" Width="126">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader x:Name="ActivityHeader" Tag="LastSeenAt" Content="{DynamicResource Column.Activity}" Style="{StaticResource CenterColumnHeaderStyle}" Click="ColumnHeader_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastSeenLabel}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ConnectionColumn" Width="250">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader x:Name="ConnectionHeader" Tag="LastConnection" Content="{DynamicResource Column.Connection}" Style="{StaticResource CenterColumnHeaderStyle}" Click="ColumnHeader_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastConnection}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                    <Image Source="Assets/geniafirewall.png" Width="38" Height="38" Opacity="0.82" />
                    <TextBlock Text="{DynamicResource Main.Empty.Title}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="{DynamicResource Main.Empty.Subtitle}" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#F2F1F6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="9,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="{DynamicResource Main.Ready}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="SummaryText" Grid.Column="1" Text="0 приложений" FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
