<Window x:Class="GeniaFirewall.ConnectionPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Prompt.Title}"
        Icon="Assets/geniafirewall.ico"
        Width="590" Height="500"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource WindowBrush}"
        Loaded="Window_Loaded">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="7" Background="#EEEAFE" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="G" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="ApplicationIcon" Width="23" Height="23" Stretch="Uniform" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ApplicationNameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PromptSubtitleText" Text="{DynamicResource Prompt.Subtitle}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#F8F7FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{DynamicResource Prompt.Publisher}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="PublisherText" Grid.Column="1" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Text="{DynamicResource Prompt.Signature}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="SignatureText" Grid.Row="1" Grid.Column="1" FontSize="10.5" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource Prompt.Network}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="ConnectionText" Grid.Row="2" Grid.Column="1" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="58" />
                    <TextBlock Grid.Row="3" Text="{DynamicResource Prompt.Process}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="ProcessText" Grid.Row="3" Grid.Column="1" FontSize="10.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="4" Text="{DynamicResource Prompt.Parent}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="ParentText" Grid.Row="4" Grid.Column="1" FontSize="10.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="5" Text="{DynamicResource Prompt.CommandLine}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="CommandLineText" Grid.Row="5" Grid.Column="1" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Grid.Row="6" Text="{DynamicResource Prompt.File}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="PathText" Grid.Row="6" Grid.Column="1" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" Text="{DynamicResource Prompt.Question}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0" />

            <StackPanel Grid.Row="3" Margin="0,5,0,8">
                <TextBlock Text="{DynamicResource Prompt.Info1}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10.5"
                           TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource Prompt.Info2}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10.5"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
                <CheckBox x:Name="DontRemindCheckBox" Content="{DynamicResource Prompt.DontRemind}" FontSize="10.5" Margin="0,8,0,0" />
            </StackPanel>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="{DynamicResource Prompt.Later}" Width="74" Style="{StaticResource SystemButton}" Click="Later_Click" />
                <Button Grid.Column="3" Content="{DynamicResource Prompt.Block}" Width="98" Style="{StaticResource SystemDangerButton}" Click="Block_Click" />
                <ComboBox x:Name="AllowScopeComboBox" Grid.Column="5" Width="126" Height="28" VerticalContentAlignment="Center" SelectedIndex="0">
                    <ComboBoxItem Content="{DynamicResource Prompt.Scope.Always}" Tag="Always" />
                    <ComboBoxItem Content="{DynamicResource Prompt.Scope.TenMinutes}" Tag="TenMinutes" />
                    <ComboBoxItem Content="{DynamicResource Prompt.Scope.UntilExit}" Tag="UntilProcessExit" />
                </ComboBox>
                <Button Grid.Column="7" Content="{DynamicResource Prompt.Allow}" Width="92" Style="{StaticResource SystemAccentButton}" Click="Allow_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
