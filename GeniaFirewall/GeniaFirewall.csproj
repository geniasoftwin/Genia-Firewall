<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\geniafirewall.ico</ApplicationIcon>
    <AssemblyName>GeniaFirewall</AssemblyName>
    <RootNamespace>GeniaFirewall</RootNamespace>
    <Version>0.7.4.0</Version>
    <AssemblyVersion>0.7.4.0</AssemblyVersion>
    <FileVersion>0.7.4.0</FileVersion>
    <Authors>GeniaFirewall</Authors>
    <Product>GeniaFirewall</Product>
    <Description>Tray-first application firewall for Windows with standalone inbound/outbound WFP enforcement.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\geniafirewall.png" />
    <Resource Include="Assets\geniafirewall.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeniaFirewall.Protocol\GeniaFirewall.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EmbeddedServicePath)' != ''">
    <EmbeddedResource Include="$(EmbeddedServicePath)"
                      LogicalName="GeniaFirewall.Payload.GeniaFirewall.Service.exe" />
  </ItemGroup>
  <ItemGroup Condition="'$(EmbeddedAutostartPath)' != ''">
    <EmbeddedResource Include="$(EmbeddedAutostartPath)"
                      LogicalName="GeniaFirewall.Payload.GeniaFirewall.Autostart.exe" />
  </ItemGroup>

  <Target Name="ValidateEmbeddedServicePayload" BeforeTargets="PrepareForBuild" Condition="'$(RequireEmbeddedService)' == 'true'">
    <Error Condition="'$(EmbeddedServicePath)' == ''"
           Text="EmbeddedServicePath is required for the single-EXE portable publish." />
    <Error Condition="'$(EmbeddedServicePath)' != '' and !Exists('$(EmbeddedServicePath)')"
           Text="Embedded GeniaFirewall.Service payload was not found: $(EmbeddedServicePath)" />
    <Error Condition="'$(EmbeddedAutostartPath)' == ''"
           Text="EmbeddedAutostartPath is required for the console-free SHA-256 autostart." />
    <Error Condition="'$(EmbeddedAutostartPath)' != '' and !Exists('$(EmbeddedAutostartPath)')"
           Text="Embedded GeniaFirewall.Autostart payload was not found: $(EmbeddedAutostartPath)" />
  </Target>
</Project>
