<Application x:Class="GeniaFirewall.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Strings.ru-RU.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="WindowBrush" Color="#F7F7FA" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F1EFFC" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DEDDE7" />
        <SolidColorBrush x:Key="TextBrush" Color="#19171F" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#757184" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6045E8" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#5137D9" />
        <SolidColorBrush x:Key="BlockedBrush" Color="#E64B55" />
        <SolidColorBrush x:Key="AllowedBrush" Color="#2E9D61" />
        <SolidColorBrush x:Key="AskBrush" Color="#D27B15" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>

        <!-- Native/system button chrome with only light GeniaFirewall color accents. -->
        <Style x:Key="SystemButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="10,1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SystemAccentButton" TargetType="Button" BasedOn="{StaticResource SystemButton}">
            <Setter Property="Foreground" Value="#5146A6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SystemDangerButton" TargetType="Button" BasedOn="{StaticResource SystemButton}">
            <Setter Property="Foreground" Value="#B93C46" />
        </Style>

        <Style x:Key="CompactTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#ECEBF2" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F6F4FD" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEEAFE" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
