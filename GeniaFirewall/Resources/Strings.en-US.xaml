    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Settings.Trusted.Enable">Automatically allow strictly verified Windows system processes</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Settings.Trusted.Info">Only a small built-in set is auto-allowed after checking the system path and a trusted Microsoft Authenticode signature. svchost.exe also requires service identity validation.</sys:String>
